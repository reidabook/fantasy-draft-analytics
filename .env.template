# Fantasy Draft Analytics — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# -------------------------------------------------------------------
# Sleeper (no auth required — just your username)
# -------------------------------------------------------------------
SLEEPER_USERNAME=your_sleeper_username

# -------------------------------------------------------------------
# ESPN (required only if you use an ESPN league)
# How to get these:
#   1. Log in to ESPN Fantasy at fantasy.espn.com
#   2. Open DevTools (F12) → Application → Cookies → espn.com
#   3. Copy espn_s2 value below (long string starting with AEB...)
#   4. Copy SWID value below (format: {xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx})
#   5. League ID is in the URL: fantasy.espn.com/football/league?leagueId=XXXXXX
# -------------------------------------------------------------------
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=

# -------------------------------------------------------------------
# weekly_update.py (median score override + high-score payout email)
# -------------------------------------------------------------------
# Exact ESPN team name for the "bye" opponent whose score gets overridden
# to the weekly median. Must match ESPN exactly (case-sensitive).
FAKE_TEAM_NAME=Fake team
# ESPN team ID for the Fake team (from the team's URL: .../team?...&teamId=N).
FAKE_TEAM_ID=

# ESPN login (for automatic re-login when the saved browser session expires
# — see save_espn_session.py / src/weekly/commish_override.py). Stored in
# PLAINTEXT here; this file is gitignored but is otherwise unencrypted on disk.
ESPN_USERNAME=
ESPN_PASSWORD=

# Gmail App Password (not your normal password) — create one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional: defaults to GMAIL_ADDRESS if unset.
NOTIFY_EMAIL=

# Optional: put a prefilled Venmo pay link for the week's high scorer in the
# report email (regular season only — stops at the playoffs). Comma-separated
# manager:handle pairs, keyed by the manager label the group text uses (first
# name, or the nickname in fetcher.py's _MANAGER_LABEL_OVERRIDES) — not team
# name, those change weekly. Leave yourself out. Ties get flagged, no link.
VENMO_HANDLES=
HIGH_SCORE_PAYOUT=5

# Optional: also text the median/high-scorer report into an iMessage group
# chat (macOS Messages.app only). Find the id with list_imessage_chats.py.
IMESSAGE_GROUP_CHAT_ID=
# Optional: your own manager label (same labels as VENMO_HANDLES). The group
# text goes out from your phone, so your team is written as "I", not by name.
GROUP_TEXT_SENDER=

# League site (build_site.py). Claude writes the weekly copy via the local
# Claude Code CLI (subscription, no API key). SITE_REPO_PATH is a local clone
# of the public GitHub Pages repo (default: ../ticerado-bowl).
# CLAUDE_BIN=/opt/homebrew/bin/claude
SITE_REPO_PATH=
SITE_URL=https://reidabook.github.io/ticerado-bowl/
# INJURY_SPOTLIGHT=Medvene  # pin the Training Room callout to a team (else most-injured)
